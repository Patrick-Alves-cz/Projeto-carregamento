{
	email {$ACME_EMAIL}
}

(websocket_api) {
	reverse_proxy api:3001 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
			dial_timeout 10s
		}
	}
}

{$API_HOST} {
	encode gzip
	import websocket_api
}

{$OCPP_HOST} {
	encode gzip
	import websocket_api
}

{$WEB_HOST} {
	encode gzip
	@driver path /app /app/*
	handle @driver {
		uri strip_prefix /app
		reverse_proxy driver:8081 {
			flush_interval -1
		}
	}
	handle /_expo* {
		reverse_proxy driver:8081 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy admin:3000
	}
}

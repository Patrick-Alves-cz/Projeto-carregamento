# EV Charge — variáveis de ambiente
# Copie para `.env` (desenvolvimento) ou `.env.production` (servidor).
# NUNCA commite senhas, JWT secrets, API keys, PAN, CVV ou credenciais OCPP.

# ─── Ambiente ────────────────────────────────────────────────────────────────
# development | staging | production
NODE_ENV=development
# Porta HTTP da API (REST /api, Socket.IO /realtime, OCPP /ocpp/:identity)
API_PORT=3001
# false desliga Swagger em /api/docs. No beta local deixe ligado.
SWAGGER_ENABLED=true

# ─── Auth (obrigatório no boot; mínimo 32 caracteres; placeholders são recusados) ─
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Admin usa BFF (cookies no domínio do Admin). Driver usa Bearer.
# true força Secure mesmo fora de NODE_ENV=production (staging com HTTPS).
COOKIE_SECURE=false
# Opcional. Só defina se Admin e API compartilham um domínio-pai.
# COOKIE_DOMAIN=.seudominio.com

# ─── CORS / origens do frontend ──────────────────────────────────────────────
# Sempre inclui localhost:3000 (Admin) e localhost:8081 (Driver).
# Em staging/produção, liste origens HTTPS extras, separadas por vírgula.
# CORS_ORIGINS=https://admin.seudominio.com,https://app.seudominio.com
CORS_ORIGINS=

# ─── PostgreSQL (Prisma 6 + banco atual — não use Prisma Postgres Cloud) ─────
# DATABASE_URL — runtime da API. Com pooler (Supabase 6543) use ?pgbouncer=true
# DIRECT_URL — Prisma CLI (migrate deploy, db push, studio). Sem pooler (5432).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Docker Postgres local (opcional):
# DATABASE_URL="postgresql://evcharge:evcharge@localhost:5432/evcharge?schema=public"
# DIRECT_URL="postgresql://evcharge:evcharge@localhost:5432/evcharge?schema=public"

# ─── Admin (Next.js) ─────────────────────────────────────────────────────────
# URL pública da API, usada no browser (Socket.IO /realtime).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# URL interna server-side (Docker). Em local, deixe vazio para usar NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL="http://api:3001/api"
API_INTERNAL_URL=

# ─── Driver (Expo) ───────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:3001/api"

# ─── Charger / OCPP ──────────────────────────────────────────────────────────
# mock = padrão local e testes. Não altere para produção de simulador.
CHARGER_PROVIDER_TYPE=mock
OCPP_HEARTBEAT_INTERVAL_SEC=60
OCPP_OFFLINE_THRESHOLD_MS=180000
OCPP_COMMAND_TIMEOUT_MS=10000
# URL pública do gateway (sem identity). Local: ws:// ; Internet: wss://
OCPP_PUBLIC_URL=ws://localhost:3001/ocpp
# Simulador local (não é secret de produção)
CHARGER_ID=EVSE-CUIABA-001
OCPP_URL=ws://localhost:3001/ocpp
CHARGER_SECRET=DemoCharger@12345

# ─── Payments ────────────────────────────────────────────────────────────────
# mock = DEMO / testes (padrão). asaas = sandbox brasileiro (PIX + cartão).
# Sem PAYMENT_API_KEY o Asaas não é usado. Nunca invente chave.
# Produção Asaas só depois de credenciais reais — até lá mantenha sandbox.
PAYMENT_PROVIDER=mock
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_API_URL=https://api-sandbox.asaas.com/v3
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Envelope de pré-autorização da sessão (centavos calculados no backend)
SESSION_AUTH_ENERGY_KWH=30
SESSION_AUTH_MINUTES=60
RESERVATION_GRACE_MINUTES=15
WAITLIST_CLAIM_MINUTES=5
RESERVATION_EARLY_CHECKIN_MINUTES=10
RESERVATION_BUFFER_MINUTES=15
IDLE_GRACE_MINUTES=5
SESSION_STALE_METER_MS=300000
CHARGER_EVENT_PROTOCOL_RETENTION_DAYS=7

# Template de produção/staging. Copie para `.env.production` no servidor.
# Nunca commite o arquivo preenchido.

NODE_ENV=production
API_PORT=3001
SWAGGER_ENABLED=true

JWT_ACCESS_SECRET="gerar-com-openssl-rand-hex-32"
JWT_REFRESH_SECRET="gerar-outro-openssl-rand-hex-32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

COOKIE_SECURE=true
COOKIE_DOMAIN=

CORS_ORIGINS=https://admin.seudominio.com,https://app.seudominio.com

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXT_PUBLIC_API_URL="https://api.seudominio.com/api"
API_INTERNAL_URL="http://api:3001/api"
EXPO_PUBLIC_API_URL="https://api.seudominio.com/api"

CHARGER_PROVIDER_TYPE=mock
OCPP_PUBLIC_URL=wss://ocpp.seudominio.com/ocpp
OCPP_HEARTBEAT_INTERVAL_SEC=60
OCPP_OFFLINE_THRESHOLD_MS=180000
OCPP_COMMAND_TIMEOUT_MS=10000

PAYMENT_PROVIDER=mock
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_API_URL=https://api-sandbox.asaas.com/v3
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

SESSION_AUTH_ENERGY_KWH=30
SESSION_AUTH_MINUTES=60

ACME_EMAIL=ops@seudominio.com
API_HOST=api.seudominio.com
OCPP_HOST=ocpp.seudominio.com
ADMIN_HOST=admin.seudominio.com
APP_HOST=app.seudominio.com

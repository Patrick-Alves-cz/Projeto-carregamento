}

model ChargerReliabilitySnapshot {
  id                       String   @id @default(cuid())
  companyId                String   @map("company_id")
  chargerId                String   @map("charger_id")
  day                      DateTime @db.Date
  score                    Int
  uptimeRate               Float    @map("uptime_rate")
  successfulSessionsRate   Float    @map("successful_sessions_rate")
  commandSuccessRate       Float    @map("command_success_rate")
  faultPenalty             Int      @map("fault_penalty")
  sessionsStarted          Int      @default(0) @map("sessions_started")
  sessionsCompleted        Int      @default(0) @map("sessions_completed")
  sessionsFailed           Int      @default(0) @map("sessions_failed")
  remoteStartFailures      Int      @default(0) @map("remote_start_failures")
  remoteStopFailures       Int      @default(0) @map("remote_stop_failures")
  offlineEvents            Int      @default(0) @map("offline_events")
  recoveredEvents          Int      @default(0) @map("recovered_events")
  createdAt                DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  charger Charger @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@unique([chargerId, day])
  @@index([companyId, day])
  @@map("charger_reliability_snapshots")
}

model ReconciliationCase {
  id           String                   @id @default(cuid())
  companyId    String                   @map("company_id")
  chargerId    String                   @map("charger_id")
  sessionId    String?                  @map("session_id")
  reason       String
  status       ReconciliationCaseStatus @default(OPEN)
  classification String                 @default("REQUIRES_RECONCILIATION")
  detectedAt   DateTime                 @default(now()) @map("detected_at")
  resolvedAt   DateTime?                @map("resolved_at")
  resolution   String?
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  charger Charger          @relation(fields: [chargerId], references: [id], onDelete: Cascade)
  session ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([chargerId, status])
  @@index([companyId, status, detectedAt])
  @@index([sessionId, status])
  @@map("reconciliation_cases")
}

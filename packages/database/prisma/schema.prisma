  charger Charger @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@index([chargerId, createdAt])
  @@index([type, createdAt])
  @@index([category, createdAt])
  @@map("charger_events")
}

model Incident {
  id           String           @id @default(cuid())
  companyId    String           @map("company_id")
  stationId    String           @map("station_id")
  chargerId    String?          @map("charger_id")
  connectorId  String?          @map("connector_id")
  sessionId    String?          @map("session_id")
  type         IncidentType
  severity     IncidentSeverity
  status       IncidentStatus   @default(OPEN)
  title        String
  description  String
  source       String           @default("system")
  openKey      String?          @unique @map("open_key")
  firstSeenAt  DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime         @default(now()) @map("last_seen_at")
  resolvedAt   DateTime?        @map("resolved_at")
  resolution   String?
  resolvedById String?          @map("resolved_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  station   Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  charger   Charger?         @relation(fields: [chargerId], references: [id], onDelete: SetNull)
  connector Connector?       @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  session   ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  resolvedBy User?           @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, severity])
  @@index([chargerId, status])
  @@index([stationId, status])
  @@index([type, status])
  @@map("incidents")
}

model MaintenanceWindow {
  id          String                  @id @default(cuid())
  companyId   String                  @map("company_id")
  stationId   String?                 @map("station_id")
  chargerId   String?                 @map("charger_id")
  connectorId String?                 @map("connector_id")
  startsAt    DateTime                @map("starts_at")
  endsAt      DateTime                @map("ends_at")
  reason      String
  status      MaintenanceWindowStatus @default(SCHEDULED)
  createdById String                  @map("created_by")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  station   Station?   @relation(fields: [stationId], references: [id], onDelete: SetNull)
  charger   Charger?   @relation(fields: [chargerId], references: [id], onDelete: SetNull)
  connector Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  createdBy User       @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, status, startsAt])
  @@index([chargerId, status])
  @@index([stationId, status])
  @@index([status, startsAt, endsAt])
  @@map("maintenance_windows")
}

model ChargerCommand {

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  DRIVER
  OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum StationStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ChargerStatus {
  AVAILABLE
  PREPARING
  CHARGING
  SUSPENDED
  FINISHING
  UNAVAILABLE
  FAULTED
  OFFLINE
}

enum ConnectorType {
  TYPE2
  CCS2
  CHADEMO
  J1772
  NACS
  GB_T
  OTHER
}

enum StationAccessType {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum ConnectorStatus {
  AVAILABLE
  PREPARING
  CHARGING
  SUSPENDED
  FINISHING
  UNAVAILABLE
  FAULTED
  RESERVED
}

enum SessionStatus {
  PENDING
  PREPARING
  ACTIVE
  PAUSED
  CHARGING_COMPLETE
  IDLE
  COMPLETED
  FAILED
  CANCELLED
}

enum SessionStopReason {
  USER_STOP
  INSUFFICIENT_BALANCE
  FAULT
  DISCONNECTED
  TIMEOUT
  ADMIN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PROCESSING
  CONFIRMED
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WalletHoldStatus {
  OPEN
  CAPTURED
  RELEASED
  EXPIRED
}

enum PaymentAuthorizationStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  RELEASED
  FAILED
  CANCELLED
}

enum PaymentReconciliationStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum WalletTxKind {
  DEPOSIT
  CHARGE
  REFUND
  ADJUSTMENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  LOW_BALANCE
  SESSION_STARTED
  SESSION_PAUSED
  SESSION_RESUMED
  SESSION_COMPLETED
  SESSION_INSUFFICIENT_BALANCE
  RESERVATION_CONFIRMED
  RESERVATION_REMINDER
  RESERVATION_STARTED
  RESERVATION_EXPIRED
  RESERVATION_NO_SHOW
  CONNECTOR_AVAILABLE
  WAITLIST_JOINED
  WAITLIST_NOTIFIED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  CHARGER_OFFLINE
  CHARGER_RECOVERED
  CONNECTOR_FAULT
  CRITICAL_INCIDENT
  SESSION_STUCK
  COMMAND_TIMEOUT
  MAINTENANCE_STARTING
  MAINTENANCE_ENDING
  FAVORITE_STATION_ONLINE
  IDLE_FEE_WARNING
  CHARGER_UNAVAILABLE_DURING_RESERVATION
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CLAIMED
  EXPIRED
  CANCELLED
}

enum PaymentMethodStatus {
  ACTIVE
  REVOKED
}

enum ChargerHealthStatus {
  HEALTHY
  DEGRADED
  UNSTABLE
  OFFLINE
  FAULTED
  MAINTENANCE
}

enum CommunicationFreshness {
  LIVE
  RECENT
  STALE
  OFFLINE
}

enum StationAvailabilityState {
  AVAILABLE
  LIMITED
  BUSY
  RESERVED
  OFFLINE
  FAULTED
  MAINTENANCE
}

enum IncidentType {
  CHARGER_OFFLINE
  CONNECTOR_FAULT
  SESSION_FAILURE
  REMOTE_START_FAILURE
  REMOTE_STOP_FAILURE
  COMMUNICATION_LOSS
  PAYMENT_FAILURE
  RESERVATION_FAILURE
  METERING_ANOMALY
  UNKNOWN
}

enum IncidentSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

enum MaintenanceWindowStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ChargerCommandType {
  REMOTE_START
  REMOTE_STOP
  RESET
  CHANGE_AVAILABILITY
}

enum ChargerCommandStatus {
  QUEUED
  SENT
  ACCEPTED
  REJECTED
  TIMEOUT
  FAILED
  COMPLETED
}

enum ReconciliationCaseStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum WaitlistScope {
  CONNECTOR
  CONNECTOR_TYPE
  STATION
}

// ─── Users & Profiles ──────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(DRIVER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile          Profile?
  companyMembers   CompanyMember[]
  vehicles         Vehicle[]
  refreshTokens    RefreshToken[]
  wallet              Wallet?
  chargingSessions    ChargingSession[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  invitationsAccepted Invitation[]         @relation("InvitationAccepter")
  notifications       InAppNotification[]
  receipts            Receipt[]
  payments            Payment[]
  paymentMethods      PaymentMethod[]
  reservations        Reservation[]
  waitlistEntries     ChargingWaitlist[]
  favoriteStations     FavoriteStation[]
  incidentsResolved    Incident[]          @relation("IncidentResolver")
  maintenanceCreated   MaintenanceWindow[] @relation("MaintenanceCreator")
  chargerCommands      ChargerCommand[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  document  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── Multi-tenant ────────────────────────────────────────────────────────────

model Company {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  cnpj      String?       @unique
  status    CompanyStatus @default(ACTIVE)
  settings  Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  members      CompanyMember[]
  stations     Station[]
  tariffs      Tariff[]
  invitations  Invitation[]
  reservations           Reservation[]
  waitlist               ChargingWaitlist[]
  payments               Payment[]
  incidents              Incident[]
  maintenanceWindows     MaintenanceWindow[]
  chargerCommands        ChargerCommand[]
  reliabilitySnapshots         ChargerReliabilitySnapshot[]
  reconciliationCases          ReconciliationCase[]
  paymentReconciliationCases   PaymentReconciliationCase[]

  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String            @map("company_id")
  userId    String            @map("user_id")
  role      CompanyMemberRole @default(OPERATOR)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

// ─── Driver fleet ────────────────────────────────────────────────────────────

model Vehicle {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  brand          String
  model          String
  year           Int?
  batteryKwh     Decimal?        @map("battery_kwh") @db.Decimal(10, 2)
  connectorTypes ConnectorType[] @map("connector_types")
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargingSessions ChargingSession[]
  reservations     Reservation[]

  @@map("vehicles")
}

// ─── Infrastructure ──────────────────────────────────────────────────────────

model Station {
  id           String            @id @default(cuid())
  companyId    String            @map("company_id")
  name         String
  address      String
  city         String?
  postalCode   String?           @map("postal_code")
  latitude     Decimal           @db.Decimal(10, 7)
  longitude    Decimal           @db.Decimal(10, 7)
  status       StationStatus     @default(ACTIVE)
  accessType   StationAccessType @default(PUBLIC) @map("access_type")
  amenities    String[]          @default([])
  openingHours Json              @default("{}") @map("opening_hours")
  tariffId     String?           @map("tariff_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tariff      Tariff?            @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  chargers    Charger[]
  reservations         Reservation[]
  waitlist             ChargingWaitlist[]
  favorites            FavoriteStation[]
  incidents            Incident[]
  maintenanceWindows   MaintenanceWindow[]

  @@index([companyId, status])
  @@map("stations")
}

model Charger {
  id                      String        @id @default(cuid())
  stationId               String        @map("station_id")
  identity                String        @unique
  serialNumber            String        @unique @map("serial_number")
  model                   String?
  vendor                  String?
  firmwareVersion         String?       @map("firmware_version")
  chargePointSerialNumber String?       @map("charge_point_serial_number")
  protocol                String?
  maxPowerKw              Decimal       @map("max_power_kw") @db.Decimal(10, 2)
  status                  ChargerStatus @default(OFFLINE)
  providerId              String?       @map("provider_id")
  lastSeenAt              DateTime?     @map("last_seen_at")
  lastHeartbeatAt         DateTime?     @map("last_heartbeat_at")
  lastBootAt              DateTime?     @map("last_boot_at")
  lastMessageAt           DateTime?     @map("last_message_at")
  healthStatus            ChargerHealthStatus @default(OFFLINE) @map("health_status")
  healthUpdatedAt         DateTime?     @map("health_updated_at")
  reliabilityScore        Int           @default(100) @map("reliability_score")
  reconnectCount24h       Int           @default(0) @map("reconnect_count_24h")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  station                Station                       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  connectors             Connector[]
  credentials            ChargerCredential[]
  ocppTxs                OcppTransaction[]
  chargerEvents          ChargerEvent[]
  incidents              Incident[]
  maintenanceWindows     MaintenanceWindow[]
  commands               ChargerCommand[]
  reliabilitySnapshots   ChargerReliabilitySnapshot[]
  reconciliationCases    ReconciliationCase[]

  @@index([stationId, status])
  @@index([providerId])
  @@index([healthStatus])
  @@map("chargers")
}

model Connector {
  id         String          @id @default(cuid())
  chargerId  String          @map("charger_id")
  number     Int
  type       ConnectorType
  maxPowerKw Decimal         @map("max_power_kw") @db.Decimal(10, 2)
  status     ConnectorStatus @default(UNAVAILABLE)
  tariffId   String?         @map("tariff_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  charger          Charger            @relation(fields: [chargerId], references: [id], onDelete: Cascade)
  tariff           Tariff?            @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  chargingSessions   ChargingSession[]
  ocppTxs            OcppTransaction[]
  reservations       Reservation[]
  waitlist           ChargingWaitlist[]
  favorites          FavoriteStation[]
  incidents          Incident[]
  maintenanceWindows MaintenanceWindow[]
  commands           ChargerCommand[]

  @@unique([chargerId, number])
  @@index([chargerId, status])
  @@map("connectors")
}

// ─── Tariffs ─────────────────────────────────────────────────────────────────

model Tariff {
  id                  String    @id @default(cuid())
  companyId           String    @map("company_id")
  name                String
  pricePerKwhCents    Int       @map("price_per_kwh_cents")
  pricePerMinuteCents Int       @default(0) @map("price_per_minute_cents")
  idleFeeCents        Int       @default(0) @map("idle_fee_cents")
  connectionFeeCents  Int       @default(0) @map("connection_fee_cents")
  parkingPriceCents   Int       @default(0) @map("parking_price_cents")
  minBalanceCents     Int       @default(1000) @map("min_balance_cents")
  minimumChargeCents  Int       @default(0) @map("minimum_charge_cents")
  currency            String    @default("BRL")
  validFrom           DateTime? @map("valid_from")
  validTo             DateTime? @map("valid_to")
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions   ChargingSession[]
  stations   Station[]
  connectors Connector[]

  @@index([companyId, active])
  @@map("tariffs")
}

// ─── Charging Sessions ───────────────────────────────────────────────────────

model ChargingSession {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  vehicleId       String             @map("vehicle_id")
  connectorId     String             @map("connector_id")
  tariffId        String             @map("tariff_id")
  tariffSnapshot  Json               @map("tariff_snapshot")
  status          SessionStatus      @default(PENDING)
  stopReason      SessionStopReason? @map("stop_reason")
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  pausedAt        DateTime?          @map("paused_at")
  energyKwh       Decimal            @default(0) @map("energy_kwh") @db.Decimal(12, 4)
  currentPowerKw  Decimal?           @map("current_power_kw") @db.Decimal(10, 2)
  currentVoltage  Decimal?           @map("current_voltage") @db.Decimal(10, 2)
  currentAmperage Decimal?           @map("current_amperage") @db.Decimal(10, 2)
  socPercent         Decimal?           @map("soc_percent") @db.Decimal(5, 2)
  costCents          Int                @default(0) @map("cost_cents")
  idTag              String?            @map("id_tag")
  remoteStopPending    Boolean            @default(false) @map("remote_stop_pending")
  reservationId        String?            @map("reservation_id")
  paymentKind          String             @default("WALLET") @map("payment_kind")
  chargingCompletedAt  DateTime?          @map("charging_completed_at")
  idleStartedAt        DateTime?          @map("idle_started_at")
  lastMeterAt          DateTime?          @map("last_meter_at")
  watchdogClass        String?            @map("watchdog_class")
  billingStatus        String             @default("NONE") @map("billing_status")
  idempotencyKey       String?            @map("idempotency_key")
  stopIdempotencyKey   String?            @map("stop_idempotency_key")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  connector          Connector           @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  tariff             Tariff              @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  meterValues        MeterValue[]
  payment            Payment?
  receipt            Receipt?
  walletTransactions WalletTransaction[]
  ocppTxs            OcppTransaction[]
  ocppAuths           OcppAuthorization[]
  reservation         Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  incidents              Incident[]
  reconciliationCases    ReconciliationCase[]
  walletHold             WalletHold?
  paymentAuthorization   PaymentAuthorization?
  paymentReconciliations PaymentReconciliationCase[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, stopIdempotencyKey])
  @@index([userId, status])
  @@index([connectorId, status])
  @@index([status, startedAt])
  @@index([idTag])
  @@index([reservationId])
  @@map("charging_sessions")
}

model MeterValue {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  timestamp   DateTime @default(now())
  energyKwh   Decimal  @map("energy_kwh") @db.Decimal(12, 4)
  powerKw     Decimal  @map("power_kw") @db.Decimal(10, 2)
  voltage     Decimal? @db.Decimal(10, 2)
  current     Decimal? @db.Decimal(10, 2)
  temperature Decimal? @db.Decimal(5, 2)
  socPercent  Decimal? @map("soc_percent") @db.Decimal(5, 2)

  session ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("meter_values")
}

// ─── Wallet (DEMO) ───────────────────────────────────────────────────────────

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  balanceCents Int      @default(0) @map("balance_cents")
  currency     String   @default("BRL")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  holds        WalletHold[]

  @@map("wallets")
}

model WalletHold {
  id             String           @id @default(cuid())
  walletId       String           @map("wallet_id")
  sessionId      String           @unique @map("session_id")
  amountCents    Int              @map("amount_cents")
  capturedCents  Int              @default(0) @map("captured_cents")
  releasedCents  Int              @default(0) @map("released_cents")
  status         WalletHoldStatus @default(OPEN)
  idempotencyKey String           @unique @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  wallet  Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  session ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@map("wallet_holds")
}

model WalletTransaction {
  id                String                @id @default(cuid())
  walletId          String                @map("wallet_id")
  sessionId         String?               @map("session_id")
  type              WalletTransactionType
  kind              WalletTxKind          @default(ADJUSTMENT)
  amountCents       Int                   @map("amount_cents")
  balanceAfterCents Int                   @map("balance_after_cents")
  description       String
  idempotencyKey    String?               @unique @map("idempotency_key")
  createdAt         DateTime              @default(now()) @map("created_at")

  wallet  Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  session ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  companyId       String?       @map("company_id")
  sessionId       String?       @unique @map("session_id")
  paymentMethodId String?       @map("payment_method_id")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("BRL")
  status          PaymentStatus @default(PENDING)
  method          String        @default("WALLET_DEMO")
  kind            String        @default("WALLET")
  provider        String        @default("mock")
  providerRef     String?       @map("provider_ref")
  pixCopyPaste    String?       @map("pix_copy_paste")
  pixQrPayload    String?       @map("pix_qr_payload")
  expiresAt       DateTime?     @map("expires_at")
  confirmedAt     DateTime?     @map("confirmed_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  failureCode     String?       @map("failure_code")
  walletCredited       Boolean @default(false) @map("wallet_credited")
  refundedAmountCents  Int     @default(0) @map("refunded_amount_cents")
  refundReason         String? @map("refund_reason")
  refundRequestedAt    DateTime? @map("refund_requested_at")
  refundIdempotencyKey String? @unique @map("refund_idempotency_key")
  idempotencyKey       String? @unique @map("idempotency_key")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  session         ChargingSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  paymentMethod   PaymentMethod?          @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  webhookEvents   PaymentWebhookEvent[]
  authorizations  PaymentAuthorization[]
  reconciliations PaymentReconciliationCase[]

  @@index([userId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([provider, providerRef])
  @@index([status, expiresAt])
  @@map("payments")
}

model PaymentMethod {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  provider         String              @default("mock")
  providerMethodId String              @map("provider_method_id")
  brand            String
  last4            String
  expMonth         Int                 @map("exp_month")
  expYear          Int                 @map("exp_year")
  isDefault        Boolean             @default(false) @map("is_default")
  status           PaymentMethodStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@map("payment_methods")
}

model PaymentWebhookEvent {
  id                 String    @id @default(cuid())
  provider           String
  externalEventId    String    @map("external_event_id")
  eventType          String    @map("event_type")
  providerPaymentId  String?   @map("provider_payment_id")
  paymentId          String?   @map("payment_id")
  payload            Json      @default("{}")
  status             String    @default("RECEIVED")
  errorSanitized     String?   @map("error_sanitized")
  receivedAt         DateTime  @default(now()) @map("received_at")
  processedAt        DateTime? @map("processed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model PaymentAuthorization {
  id                     String                      @id @default(cuid())
  sessionId              String                      @unique @map("session_id")
  paymentId              String?                     @map("payment_id")
  method                 String
  authorizedAmountCents  Int                         @map("authorized_amount_cents")
  capturedAmountCents    Int                         @default(0) @map("captured_amount_cents")
  releasedAmountCents    Int                         @default(0) @map("released_amount_cents")
  status                 PaymentAuthorizationStatus  @default(PENDING)
  providerReference      String?                     @map("provider_reference")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")

  session ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payment Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, status])
  @@map("payment_authorizations")
}

model PaymentReconciliationCase {
  id             String                       @id @default(cuid())
  companyId      String                       @map("company_id")
  paymentId      String?                      @map("payment_id")
  sessionId      String?                      @map("session_id")

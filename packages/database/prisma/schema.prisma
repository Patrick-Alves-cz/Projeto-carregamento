  updatedAt      DateTime                     @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  session ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([companyId, status, detectedAt])
  @@index([paymentId, status])
  @@index([sessionId, status])
  @@map("payment_reconciliation_cases")
}

model Reservation {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  companyId   String            @map("company_id")
  stationId   String            @map("station_id")
  connectorId String?           @map("connector_id")
  vehicleId   String            @map("vehicle_id")
  startAt     DateTime          @map("start_at")
  endAt       DateTime          @map("end_at")
  status      ReservationStatus @default(CONFIRMED)
  graceUntil  DateTime?         @map("grace_until")
  expiresAt   DateTime?         @map("expires_at")
  cancelledAt DateTime?         @map("cancelled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  station    Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  connector  Connector?        @relation(fields: [connectorId], references: [id], onDelete: SetNull)

}

model OcppTransaction {
  id                String    @id @default(cuid())
  chargerId         String    @map("charger_id")
  connectorId       String    @map("connector_id")
  connectorNumber   Int       @map("connector_number")
  sessionId         String    @map("session_id")
  ocppTransactionId Int       @map("ocpp_transaction_id")
  idTag             String    @map("id_tag")
  meterStartWh      Int       @map("meter_start_wh")
  meterStopWh       Int?      @map("meter_stop_wh")
  startedAt         DateTime  @map("started_at")
  stoppedAt         DateTime? @map("stopped_at")
  stopReason        String?   @map("stop_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  DRIVER
  OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum StationStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ChargerStatus {
  AVAILABLE
  PREPARING
  CHARGING
  SUSPENDED
  FINISHING
  UNAVAILABLE
  FAULTED
  OFFLINE
}

enum ConnectorType {
  TYPE2
  CCS2
  CHADEMO
  J1772
  NACS
}

enum ConnectorStatus {
  AVAILABLE
  PREPARING
  CHARGING
  SUSPENDED
  FINISHING
  UNAVAILABLE
  FAULTED
}

enum SessionStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum SessionStopReason {
  USER_STOP
  INSUFFICIENT_BALANCE
  FAULT
  DISCONNECTED
  TIMEOUT
  ADMIN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── Users & Profiles ──────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(DRIVER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile          Profile?
  companyMembers   CompanyMember[]
  vehicles         Vehicle[]
  refreshTokens    RefreshToken[]
  wallet           Wallet?
  chargingSessions ChargingSession[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  document  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── Multi-tenant ────────────────────────────────────────────────────────────

model Company {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  cnpj      String?       @unique
  status    CompanyStatus @default(ACTIVE)
  settings  Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  members  CompanyMember[]
  stations Station[]
  tariffs  Tariff[]

  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String            @map("company_id")
  userId    String            @map("user_id")
  role      CompanyMemberRole @default(OPERATOR)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

// ─── Driver fleet ────────────────────────────────────────────────────────────

model Vehicle {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  brand          String
  model          String
  year           Int?
  batteryKwh     Decimal? @map("battery_kwh") @db.Decimal(10, 2)
  connectorTypes ConnectorType[] @map("connector_types")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargingSessions ChargingSession[]

  @@map("vehicles")
}

// ─── Infrastructure ──────────────────────────────────────────────────────────

model Station {
  id        String        @id @default(cuid())
  companyId String        @map("company_id")
  name      String
  address   String
  latitude  Decimal       @db.Decimal(10, 7)
  longitude Decimal       @db.Decimal(10, 7)
  status    StationStatus @default(ACTIVE)
  amenities String[]      @default([])
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chargers Charger[]

  @@index([companyId, status])
  @@map("stations")
}

model Charger {
  id           String        @id @default(cuid())
  stationId    String        @map("station_id")
  serialNumber String        @unique @map("serial_number")
  model        String?
  maxPowerKw   Decimal       @map("max_power_kw") @db.Decimal(10, 2)
  status       ChargerStatus @default(OFFLINE)
  providerId   String?       @map("provider_id")
  lastSeenAt   DateTime?     @map("last_seen_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  station    Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  connectors Connector[]

  @@index([stationId, status])
  @@map("chargers")
}

model Connector {
  id         String          @id @default(cuid())
  chargerId  String          @map("charger_id")
  number     Int
  type       ConnectorType
  maxPowerKw Decimal         @map("max_power_kw") @db.Decimal(10, 2)
  status     ConnectorStatus @default(UNAVAILABLE)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  charger          Charger           @relation(fields: [chargerId], references: [id], onDelete: Cascade)
  chargingSessions ChargingSession[]

  @@unique([chargerId, number])
  @@index([chargerId, status])
  @@map("connectors")
}

// ─── Tariffs ─────────────────────────────────────────────────────────────────

model Tariff {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  name             String
  pricePerKwhCents Int      @map("price_per_kwh_cents")
  minBalanceCents  Int      @default(500) @map("min_balance_cents")
  currency         String   @default("BRL")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions ChargingSession[]

  @@index([companyId, active])
  @@map("tariffs")
}

// ─── Charging Sessions ───────────────────────────────────────────────────────

model ChargingSession {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  vehicleId       String             @map("vehicle_id")
  connectorId     String             @map("connector_id")
  tariffId        String             @map("tariff_id")
  tariffSnapshot  Json               @map("tariff_snapshot")
  status          SessionStatus      @default(PENDING)
  stopReason      SessionStopReason? @map("stop_reason")
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  pausedAt        DateTime?          @map("paused_at")
  energyKwh       Decimal            @default(0) @map("energy_kwh") @db.Decimal(12, 4)
  currentPowerKw  Decimal?           @map("current_power_kw") @db.Decimal(10, 2)
  currentVoltage  Decimal?           @map("current_voltage") @db.Decimal(10, 2)
  currentAmperage Decimal?           @map("current_amperage") @db.Decimal(10, 2)
  costCents       Int                @default(0) @map("cost_cents")
  idempotencyKey  String?            @unique @map("idempotency_key")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  connector          Connector           @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  tariff             Tariff              @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  meterValues        MeterValue[]
  payment            Payment?
  walletTransactions WalletTransaction[]

  @@index([userId, status])
  @@index([connectorId, status])
  @@index([status, startedAt])
  @@map("charging_sessions")
}

model MeterValue {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  timestamp   DateTime @default(now())
  energyKwh   Decimal  @map("energy_kwh") @db.Decimal(12, 4)
  powerKw     Decimal  @map("power_kw") @db.Decimal(10, 2)
  voltage     Decimal? @db.Decimal(10, 2)
  current     Decimal? @db.Decimal(10, 2)
  temperature Decimal? @db.Decimal(5, 2)

  session ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("meter_values")
}

// ─── Wallet (DEMO) ───────────────────────────────────────────────────────────

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  balanceCents Int      @default(0) @map("balance_cents")
  currency     String   @default("BRL")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String                @id @default(cuid())
  walletId          String                @map("wallet_id")
  sessionId         String?               @map("session_id")
  type              WalletTransactionType
  amountCents       Int                   @map("amount_cents")
  balanceAfterCents Int                   @map("balance_after_cents")
  description       String
  idempotencyKey    String?               @unique @map("idempotency_key")
  createdAt         DateTime              @default(now()) @map("created_at")

  wallet  Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  session ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id          String        @id @default(cuid())
  sessionId   String        @unique @map("session_id")
  amountCents Int           @map("amount_cents")
  currency    String        @default("BRL")
  status      PaymentStatus @default(PENDING)
  method      String        @default("WALLET_DEMO")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  session ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── Audit Events ────────────────────────────────────────────────────────────

model ChargingEvent {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  eventType  String   @map("event_type")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("charging_events")
}
